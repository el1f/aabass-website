---
const posters = [
  "poster_thumbnail_1.jpg",
  "poster_thumbnail_2.jpg",
  "poster_thumbnail_3.jpg",
  "poster_thumbnail_4.jpg",
  "poster_thumbnail_5.jpg",
  "poster_thumbnail_6.jpg",
  "poster_thumbnail_7.jpg",
  "poster_thumbnail_8.jpg",
  "poster_thumbnail_9.jpg",
  "poster_thumbnail_10.jpg",
  "poster_thumbnail_11.jpg",
  "poster_thumbnail_12.jpg",
]
---

<div class="relative w-full h-full overflow-hidden bg-muted">
  <div class="absolute -inset-3 flex gap-1 opacity-80 group-hover:opacity-100 transition-opacity duration-300">
    {posters.map((src, i) => (
      <img
        src={`/posters/${src}`}
        alt=""
        class:list={[
          "h-[75%] w-auto rounded-sm object-cover shrink-0",
          i % 2 === 0 ? "self-start" : "self-end",
        ]}
      />
    ))}
  </div>
</div>