---
import Layout from "@/layouts/main.astro"

const STANDARD_POSTERS = [
  { title: "Dafne", thumbnail: "poster_thumbnail_1.jpg", src: "poster_1.jpg" },
  { title: "Busy", thumbnail: "poster_thumbnail_2.jpg", src: "poster_2.jpg" },
  { title: "Dolce far niente", thumbnail: "poster_thumbnail_3.jpg", src: "poster_3.jpg" },
  { title: "Free speech", thumbnail: "poster_thumbnail_4.jpg", src: "poster_4.jpg" },
  { title: "Hardship", thumbnail: "poster_thumbnail_5.jpg", src: "poster_5.jpg" },
  { title: "Hush", thumbnail: "poster_thumbnail_6.jpg", src: "poster_6.jpg" },
  { title: "The Planner", thumbnail: "poster_thumbnail_7.jpg", src: "poster_7.jpg" },
  { title: "MuseumPark", thumbnail: "poster_thumbnail_8.jpg", src: "poster_8.jpg" },
  { title: "Pasticciotto ergo sum", thumbnail: "poster_thumbnail_9.jpg", src: "poster_9.jpg" },
  { title: "The portal", thumbnail: "poster_thumbnail_10.jpg", src: "poster_10.jpg" },
  { title: "Sesh", thumbnail: "poster_thumbnail_11.jpg", src: "poster_11.jpg" },
  { title: "Final frontier", thumbnail: "poster_thumbnail_12.jpg", src: "poster_12.jpg" },
]

const VINYL_COVERS = [
  { title: "Scoop", thumbnail: "disc_thumbnail_1.jpg", src: "disc_1.jpg" },
  { title: "Moo", thumbnail: "disc_thumbnail_2.jpg", src: "disc_2.jpg" },
  { title: "Irrequieto", thumbnail: "disc_thumbnail_3.jpg", src: "disc_3.jpg" },
  { title: "Hippy Ludens", thumbnail: "disc_thumbnail_4.jpg", src: "disc_4.jpg" },
  { title: "Land it", thumbnail: "disc_thumbnail_5.jpg", src: "disc_5.jpg" },
]
---

<Layout title="My poster collection">
  <header class="container max-w-2xl px-6 pt-32 pb-16 mx-auto">
    <h1 class="mb-4 text-4xl font-bold leading-tight md:text-5xl">
      My posters collection
    </h1>
    <p class="text-sm md:text-base md:leading-relaxed text-muted-foreground">
      Print is not dead. I love to design posters and other printed media in my free
      time to experiment with the latest design trends and try out compositions and
      techniques that I wouldn't be able to use in my day-to-day work.
      <br /><br />
      This is a collection of my favorite posters that I have designed over the past
      months, including some of my first experiments with print design. I hope you
      enjoy them as much as I do!
    </p>
  </header>

  <div class="container max-w-2xl px-6 mx-auto my-6">
    <h2 class="text-2xl font-bold leading-tight md:text-3xl">Standard Print</h2>
  </div>

  <section class="container grid max-w-5xl grid-cols-1 gap-8 px-6 mx-auto mb-48 md:grid-cols-3 md:px-0">
    {STANDARD_POSTERS.map(({ title, thumbnail }) => (
      <div class="relative cursor-pointer aspect-[297/420] bg-muted">
        <img
          alt={title}
          class="block w-full h-full object-cover"
          src={`/posters/${thumbnail}`}
          loading="lazy"
        />
      </div>
    ))}
  </section>

  <div class="container max-w-2xl px-6 mx-auto my-6">
    <h2 class="text-2xl font-bold leading-tight md:text-3xl">Vinyl covers</h2>
  </div>

  <section class="container grid max-w-5xl grid-cols-1 gap-8 px-6 mx-auto mb-48 md:grid-cols-3 md:px-0">
    {VINYL_COVERS.map(({ title, thumbnail }) => (
      <div class="relative cursor-pointer aspect-square bg-muted">
        <img
          alt={title}
          class="block w-full h-full object-cover"
          src={`/posters/${thumbnail}`}
          loading="lazy"
        />
      </div>
    ))}
  </section>
</Layout>