---
import Layout from "@/layouts/main.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import XaiCover from "@/components/covers/XaiCover.astro"
import NtropyCover from "@/components/covers/NtropyCover.astro"
import PostersCover from "@/components/covers/PostersCover.astro"
---

<Layout title="Work">
  <header class="container max-w-2xl px-6 pt-32 pb-8 mx-auto mb-24">
    <h1 class="mb-4 text-4xl font-bold leading-snug md:text-5xl md:leading-snug">
      Work
    </h1>
    <p class="text-sm md:text-base md:leading-relaxed text-muted-foreground">
      A selection of projects I've worked on over the years, spanning product
      development, design systems, and personal creative work.
    </p>
  </header>

  <section class="container grid max-w-5xl grid-cols-1 gap-6 px-6 mx-auto mb-48 md:grid-cols-2">
    <ProjectCard
      title="Grok"
      subtitle="xAI · 2024 – present"
      href="/cases/xai"
    >
      <XaiCover slot="cover" />
    </ProjectCard>

    <ProjectCard
      title="Ntropy"
      subtitle="Principal Front-end & Product Designer · 2015 – 2023"
      href="/cases/ntropy"
    >
      <NtropyCover slot="cover" />
    </ProjectCard>

    <ProjectCard
      title="Poster Design"
      subtitle="Personal · Ongoing"
      href="/posters"
    >
      <PostersCover slot="cover" />
    </ProjectCard>
  </section>
</Layout>